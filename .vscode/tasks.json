{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Start Backend (NestJS)",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Open Prisma Studio",
      "type": "shell",
      "command": "npx prisma studio",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "Start All (Frontend, Backend, Studio)",
      "dependsOn": [
        "Start Frontend (Next.js)",
        "Start Backend (NestJS)",
        "Open Prisma Studio"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
